# Template .env per Video Segmentation
# Rinomina questo file in .env e modifica i percorsi se necessario
# NOTA: Attualmente non usato, per future espansioni

# Percorsi (valori di default considerano struttura standard)
CSV_PATH=dataset/how2sign_realigned_train.csv
VIDEO_DIR=dataset/How2Sign
OUTPUT_DIR=dataset/segmented
ANALYSIS_DIR=analysis

# FFmpeg
FFMPEG_TIMEOUT_SECONDS=300
VIDEO_CODEC=copy
AUDIO_CODEC=copy

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/segmentation.log

# Processing
SAMPLE_SIZE=2
MAX_SEGMENTATIONS=0
VERBOSE=true

# Opzioni avanzate
OVERWRITE_EXISTING=true
TRACK_DATABASE=json
GENERATE_VISUALIZATIONS=true
